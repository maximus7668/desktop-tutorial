# Copia este archivo como .env (no se sube al repo) y rellena solo lo que uses.
# En sesiones en la nube: ponlas como secretos del entorno, no en archivos.

# Voz (elige una en canal.yaml → voz.proveedor)
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
OPENAI_API_KEY=

# Imágenes y vídeo de stock (gratis): pexels.com/api · pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Tendencias (clave de API de YouTube Data v3, sin OAuth)
YOUTUBE_API_KEY=

# En la nube: contenido de secretos/token-youtube.json tras «python -m canal autorizar»
YT_TOKEN_JSON=
