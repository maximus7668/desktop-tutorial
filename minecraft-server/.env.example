# Copia este archivo a .env y rellénalo.
# Memoria del servidor (4G va bien para 5-10 jugadores con estos mods)
MEMORY=4G
# Nombres de los administradores (Java). Para Bedrock pon ".NombreXbox"
OPS=TuNombreJava
# Lista blanca (separada por comas). Bedrock con punto delante: .GamertagPS
WHITELIST=TuNombreJava,.GamertagDeTuAmigo
# Contraseña RCON para la consola remota
RCON_PASSWORD=cambia-esto
