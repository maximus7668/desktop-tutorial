# Copia este fichero a .env y rellénalo. NUNCA subas .env al repositorio.

# --- Entorno ---------------------------------------------------------------
# test | production (los datos reales solo existen en production)
APP_ENV=test
# Por defecto data/<APP_ENV>.db
# DATABASE_PATH=data/production.db
# Obligatorio en producción, >= 32 caracteres:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000

# --- Dinero (solo se leen en el PRIMER arranque) ------------------------------
# Con 0 € el sistema no puede gastar nada y trabaja solo con herramientas gratuitas.
# Para aportar dinero después: panel → Finanzas → Aportar capital, o python -m app.cli add-capital 300
INITIAL_CAPITAL_EUR=0
# Gasto de API que autorizas por adelantado cada mes (0 = cada llamada pide aprobación).
# Sin capital aportado no se usa aunque lo pongas.
API_MONTHLY_ENVELOPE_EUR=0

# --- Modelo de IA (opcional) ------------------------------------------------
# none | anthropic
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
# https://console.anthropic.com → API keys. Pon también un límite de gasto en la consola de Anthropic.
ANTHROPIC_API_KEY=
# Precios para ESTIMAR el coste (revisa los vigentes)
LLM_PRICE_IN_USD_MTOK=4
LLM_PRICE_OUT_USD_MTOK=20
USD_TO_EUR=0.92

# --- Pagos (solo cuando el checklist legal/fiscal esté completo) -----------
# whsec_... del endpoint https://TU_DOMINIO/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Email saliente (opcional) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Datos del titular (aviso legal, LSSI) ---------------------------------
OWNER_LEGAL_NAME=
OWNER_TAX_ID=
OWNER_ADDRESS=
OWNER_CONTACT_EMAIL=

# --- Solo pruebas locales ----------------------------------------------------
# Permite crear el admin sin teclear la contraseña (ignorado si APP_ENV=production)
# ADMIN_PASSWORD=
